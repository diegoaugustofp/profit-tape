//=====================================================================
// ignicao -- ESTRATEGIA DE EXECUCAO NTSL (WINFUT, grafico em SEGUNDOS)
//
// PORTE para o Profit do EA `ea_ignicao` (config/ea_ignicao.yaml,
// docs/eas/ignicao.md). Existe porque o ProfitDLL caiu em 04/10/2026 e o
// `record` nao sobe. MECANISMO NOVO com a mesma regra escrita: carimbo e
// contagem PROPRIOS; nao soma com o EA Python (skill forward, regra 2).
// Ficha: docs/NTSL_PORTE_EAS.md. Este arquivo e' a versao que OPERA; o
// `ignicao_forward.ntsl` (so' visual) continua existindo e e' a base da
// logica de deteccao.
//
// SO' CONTA SIMULADOR. O ignicao so' tinha dry_run no Python (a ficha:
// "so' dry_run ate' a conta demo medir o deslizamento"). O NTSL nao
// trava a conta; a trava e' a conta que voce escolhe. Confira antes.
//
// REGRA (a de `ea/sinal_ignicao.py`)
//   O WIN anda >= 500 pts contra a referencia de >= 60 s atras, entre
//   09:16 e 17:00 -> entra a MERCADO a favor do movimento. Refratario de
//   30 min depois de TODA deteccao (mesmo ignorada). Maximo 4 entradas
//   por dia. Uma posicao por vez (deteccao com posicao: ignorada).
//   alvo = nivel +- 530, stop = nivel -+ 530 -- a partir do NIVEL da
//   deteccao (referencia +- 500), NAO do fill. Tempo maximo 60 min
//   (> 3.600 s). Zeragem 18:00.
//
// DIFERENCAS PARA O EA PYTHON (declaradas, nao corrigidas)
//   1. Referencia = Close da barra de `BarrasJanela` atras (Python: ultimo
//      NEGOCIO de >= 60 s atras). Com barra de 1 s o erro e' <= 1 s.
//   2. Nivel de deteccao = referencia +- 500 (Python: preco do primeiro
//      negocio alem do limiar, 0-15 pts adiante). Os niveis de alvo/stop
//      saem deste nivel teorico. O FILL e' a mercado: o slippage
//      "deteccao -> fill" aqui e' o do simulador do Profit.
//   3. Refratario e tempo contados em BARRAS (segundo sem negocio nao
//      gera barra: o relogio atrasa um pouco em fase parada).
//   4. Hora = Time (HHMM): janelas com resolucao de minuto.
//   5. Se uma barra cruza os dois lados, vale o lado do fechamento.
//   6. Ancoras de agenda (930/1000/1030/1500) NAO foram portadas: so'
//      registravam, nao decidiam.
//   7. Fills no simulador do Profit, nao no tape do record.
//   8. v4.35: no backtest de 05-06/10 TODA entrada caiu no ramo ORFA (estado
//      perdido no reprocessamento do candle apos o fill) e fechou em 1 barra.
//      Agora a barra de entrada reprocessada se reconhece e reconstroi o
//      estado (evento 11). Se o estado se perder DEPOIS, o ORFA continua
//      fechando por seguranca. O log NTSD diz qual dos dois acontece.
//   9. v4.42: NIVEIS VELHOS (achado de 07/10, simulador). Uma entrada 4 s
//      depois da saida da anterior foi enviada com alvo/stop DA OPERACAO
//      ANTERIOR: o candle anterior foi avaliado com a posicao ainda aberta e
//      guardou os niveis dela; o reprocessamento do candle de entrada le' isso
//      em [1], os niveis nao estavam zerados, a reconstrucao (so' com niveis
//      zerados) nao rodou, e o alvo velho, abaixo do preco, saiu a mercado em
//      0,13 s (-5 pts). Agora: se ha' posicao e o DailyResult mudou desde o
//      candle anterior, um trade FECHOU depois daquela avaliacao e os niveis
//      de [1] sao descartados antes do bloco de posicao. NTSD ganha a coluna
//      final Descarte (1 = descartou) e o console imprime NTSI|PARAMS no
//      primeiro candle (BarrasJanela, SegBarra, Refratario em barras): o
//      replay de 07/10 rodou com BarrasJanela 60 enquanto a automacao ao vivo
//      usava 12, e nada no console mostrava isso.
//
// COMO LIGAR (Automacao de estrategias, WINFUT em 1 SEGUNDO)
//   - Grafico em SEGUNDOS: 1 s => BarrasJanela 60 | 5 s => 12 | 15 s => 4.
//     (Em 1 minuto a regra perde: 27/52 no teste sintetico.)
//   - Modo: "Realizar envio de ordens no FECHAMENTO DO CANDLE" + a opcao
//     "executar apenas no fechamento do candle ou com atualizacao de
//     posicao" MARCADA.
//   - Quantidade por Ordem = 1; Quantidade maxima da posicao = 1.
//   - CONTA: SIMULADOR.
//   - ModoSaidaOCO = 1 manda stop+alvo como ordens ToCover. Em barra de
//     1 s o Profit pode reeditar a OCO a cada barra mesmo sem mudanca
//     de nivel -- NAO SEI se isso gera enxurrada de ordens. Se gerar,
//     use ModoSaidaOCO = 0: a saida passa a ser ClosePosition a mercado
//     quando a barra de 1 s toca alvo ou stop (sem ordem em repouso).
//   - Ligar ANTES das 09:16. Estado zera a cada dia.
//
// IDIOMAS (skill engenharia 3.1): leitura posicional no topo; sem Abs();
// Float no ConsoleLog. NAO COMPILEI: ver docs/NTSL_PORTE_EAS.md.
//=====================================================================

input
  Lote(1);
  BarrasJanela(60);          // barras que cobrem 60 s
  LimiarPts(500);
  AlvoPts(530);
  StopPts(530);
  RefratarioSeg(1800);
  TempoMaxSeg(3600);
  PrimeiraHHMM(916);         // 09:15 + 60 s de janela
  FimHHMM(1700);             // ultima deteccao antes das 17:00
  ZerarHHMM(1800);
  MaxOpsDia(4);
  SlackStopPts(150);
  ModoSaidaOCO(1);           // 1 = ToCover (OCO) | 0 = ClosePosition por barra
  LogAtivo(1);
  HeartbeatBarras(300);      // uma linha de vida a cada N barras (0 = nunca)
  LogDiag(1);                // 1 = linha NTSD a cada avaliacao com posicao/deteccao
                             // (NAO depende de LastBarOnChart: aparece no backtest)
  AlarmeCruzado(1);          // 1 = linha NTSI|ALVO_CRUZADO (v4.38, so' diagnostico)

var
  sData, sDataAnt, sDataRef, sHora                 : Float;
  sClose, sHigh, sLow, sRef, sSegBarra             : Float;
  sLadoPos, sNivel, sAlvoPx, sStopPx, sBarsPos    : Float;
  sRefrat, sOps, sLado, sStatus, sEvento           : Float;
  sDailyRes, sPos, sNivelDet, sBar, sLadoAnt       : Float;
  sDailyAnt, sDescarte, sPar                       : Float;
  bNovoDia, bNaJanela, bTemRef, bSaida, bRecons    : Boolean;
begin
  //-------------------------------------------------------------------
  // LEITURAS POSICIONAIS no topo, atribuicao simples.
  //-------------------------------------------------------------------
  sData     := Date;
  sHora     := Time;
  sClose    := Close;
  sHigh     := High;
  sLow      := Low;
  sDataAnt  := sData[1];
  sDataRef  := sData[BarrasJanela];
  sRef      := sClose[BarrasJanela];
  sLadoAnt  := sLadoPos[1];
  sLadoPos  := sLadoPos[1];
  sNivel    := sNivel[1];
  sAlvoPx   := sAlvoPx[1];
  sStopPx   := sStopPx[1];
  sBarsPos  := sBarsPos[1];
  sRefrat   := sRefrat[1];
  sOps      := sOps[1];
  sDailyAnt := sDailyRes[1];

  sSegBarra := 60 / BarrasJanela;
  bNovoDia  := (sData <> sDataAnt);
  if bNovoDia then
  begin
    sLadoPos := 0; sNivel := 0; sAlvoPx := 0; sStopPx := 0; sBarsPos := 0;
    sRefrat := 0; sOps := 0;
  end;

  // v4.42: parametros efetivos, uma vez, sem LastBarOnChart (aparece no
  // backtest; ao vivo o Profit nao guarda console).
  if (LogDiag = 1) and (CurrentBar = 1) then
  begin
    sPar := RefratarioSeg / sSegBarra;
    ConsoleLog("NTSI|PARAMS|BarrasJanela=" + BarrasJanela + "|SegBarra=" + sSegBarra
      + "|RefratBarras=" + sPar + "|LimiarPts=" + LimiarPts
      + "|ModoSaidaOCO=" + ModoSaidaOCO);
  end;

  // v4.42: NIVEIS VELHOS. Com posicao e o resultado fechado do dia diferente
  // do que o candle anterior registrou, um trade fechou DEPOIS daquela
  // avaliacao: os niveis lidos em [1] sao dele, nao desta posicao.
  sDailyRes := DailyResult(False);
  sDescarte := 0;
  if HasPosition and ((sDailyRes - sDailyAnt > 0.001) or (sDailyAnt - sDailyRes > 0.001)) then
  begin
    sDescarte := 1;
    sLadoPos := 0; sNivel := 0; sAlvoPx := 0; sStopPx := 0; sBarsPos := 0;
  end;

  sStatus := 0;
  sEvento := 0;
  sLado := 0;
  sNivelDet := 0;
  sPos := 0;
  bRecons := False;

  //-------------------------------------------------------------------
  // DETECCAO (pura, ANTES do bloco de posicao: o reprocessamento da barra
  // de entrada precisa reconhecer o proprio sinal). O refratario comeca em
  // TODA deteccao, como no DetectorIgnicao do EA.
  //-------------------------------------------------------------------
  if sRefrat > 0 then
    sRefrat := sRefrat - 1;

  bNaJanela := (sHora >= PrimeiraHHMM) and (sHora < FimHHMM);
  bTemRef   := (CurrentBar > BarrasJanela) and (sDataRef = sData);

  if bTemRef and bNaJanela and (sRefrat <= 0) then
  begin
    if sHigh - sRef >= LimiarPts then
      sLado := 1;
    if sRef - sLow >= LimiarPts then
    begin
      if sLado = 0 then
        sLado := 0 - 1
      else if sClose < sRef then
        sLado := 0 - 1;
    end;
  end;
  if sLado <> 0 then
    sNivelDet := sRef + sLado * LimiarPts;

  //-------------------------------------------------------------------
  // 1. POSICAO ABERTA: saidas. Ordem do EA: tempo -> alvo -> stop -> 18:00
  //-------------------------------------------------------------------
  if HasPosition then
  begin
    sPos := 1;
    sBarsPos := sBarsPos + 1;
    bSaida := False;

    if (sLadoPos = 0) or (sAlvoPx = 0) or (sStopPx = 0) then
    begin
      if (sLado <> 0) and (sOps < MaxOpsDia) and (sBarsPos <= 1) then
      begin
        // v4.35: REPROCESSAMENTO DA BARRA DE ENTRADA. O Profit reprocessa o
        // candle depois do fill e o estado gravado na avaliacao anterior
        // nao esta' em [1]. O sinal e' deterministico (so' depende de
        // dados da barra), entao ele se reconhece de novo: reconstroi o
        // estado que a avaliacao perdida teria gravado, SEM nova ordem.
        bRecons   := True;
        sOps      := sOps + 1;
        sLadoPos  := sLado;
        sNivel    := sNivelDet;
        sAlvoPx   := Round2Fraction(sNivelDet + sLado * AlvoPts);
        sStopPx   := Round2Fraction(sNivelDet - sLado * StopPts);
        sBarsPos  := 0;
        sEvento   := 11;
      end
      else
      begin
        ConsoleLog("NTSI|ORFA|" + sData + "|" + sHora + "|posicao sem niveis: ClosePosition");
        bSaida := True;
        sEvento := 9;
      end;
    end
    else if sBarsPos * sSegBarra > TempoMaxSeg then
    begin
      bSaida := True;
      sEvento := 3;
    end
    else if sHora >= ZerarHHMM then
    begin
      bSaida := True;
      sEvento := 4;
    end
    else if ModoSaidaOCO = 0 then
    begin
      if sLadoPos > 0 then
      begin
        if (sHigh >= sAlvoPx) and (sLow <= sStopPx) then
        begin bSaida := True; sEvento := 5; end
        else if sHigh >= sAlvoPx then
        begin bSaida := True; sEvento := 1; end
        else if sLow <= sStopPx then
        begin bSaida := True; sEvento := 2; end;
      end
      else
      begin
        if (sLow <= sAlvoPx) and (sHigh >= sStopPx) then
        begin bSaida := True; sEvento := 5; end
        else if sLow <= sAlvoPx then
        begin bSaida := True; sEvento := 1; end
        else if sHigh >= sStopPx then
        begin bSaida := True; sEvento := 2; end;
      end;
    end;

    if bSaida then
      ClosePosition
    else if ModoSaidaOCO = 1 then
    begin
      if IsBought then
      begin
        SellToCoverStop(sStopPx, sStopPx - SlackStopPts, Lote);
        SellToCoverLimit(sAlvoPx, Lote);
      end
      else
      begin
        BuyToCoverStop(sStopPx, sStopPx + SlackStopPts, Lote);
        BuyToCoverLimit(sAlvoPx, Lote);
      end;
    end;
  end
  else
  begin
    sBarsPos := 0;
    sLadoPos := 0; sNivel := 0; sAlvoPx := 0; sStopPx := 0;
  end;

  //-------------------------------------------------------------------
  // 2. ARMAR (deteccao acima; com ou sem posicao o refratario comeca)
  //-------------------------------------------------------------------
  if sLado <> 0 then
  begin
    sRefrat := RefratarioSeg / sSegBarra;
    if HasPosition then
      sStatus := 2
    else if sOps >= MaxOpsDia then
      sStatus := 3
    else
    begin
      sStatus  := 1;
      sEvento  := 10;
      sOps     := sOps + 1;
      sLadoPos := sLado;
      sNivel   := sNivelDet;
      sAlvoPx  := Round2Fraction(sNivelDet + sLado * AlvoPts);
      sStopPx  := Round2Fraction(sNivelDet - sLado * StopPts);
      if sLado > 0 then
        BuyAtMarket(Lote)
      else
        SellShortAtMarket(Lote);
    end;
  end;

  //-------------------------------------------------------------------
  // 3. LOG (ordem congelada; docs/NTSL_PORTE_EAS.md). So' eventos e a
  //    linha de vida; so' no ultimo candle (nao despeja historico).
  //    Status: 1 ARMOU | 2 ignorada posicionado | 3 limite do dia
  //    Evento: 1 alvo | 2 stop | 3 tempo | 4 zeragem | 5 ambiguo
  //            | 9 orfa | 10 entrada | 11 estado reconstruido (v4.35)
  //-------------------------------------------------------------------
  // DIAGNOSTICO (v4.35): sem LastBarOnChart, para aparecer no backtest.
  // LadoAnt = estado que o candle ANTERIOR deixou em [1]; Recons = 1 se
  // este candle reconstruiu o estado. Duas linhas com o MESMO Bar =
  // reprocessamento do mesmo candle.
  if (LogDiag = 1) and (HasPosition or (sLado <> 0) or (sEvento <> 0)) then
  begin
    sBar := CurrentBar;
    ConsoleLog("NTSD|" + sBar + "|" + sData + "|" + sHora + "|" + sClose
      + "|" + sPos + "|" + sLadoAnt + "|" + sLadoPos + "|" + sOps
      + "|" + sBarsPos + "|" + sRefrat + "|" + sLado + "|" + sStatus
      + "|" + sEvento + "|" + sAlvoPx + "|" + sStopPx + "|" + sDescarte);
  end;

  // ALARME DE EXECUCAO (v4.38, SO' diagnostico, nao altera ordens nem
  // estado). Posicao ainda aberta num candle POSTERIOR ao de entrada
  // (BarsPos >= 1) cujo High/Low cruzou alvo ou stop = a ordem ToCover nao
  // executou. Medido em 06/10: na 1a passada do backtest isso acontece
  // (Pend=1, preco cruzou, sem fill); nas passadas finais nunca. Ao vivo,
  // uma linha destas e' DEFEITO DE EXECUCAO: parar e nao contar.
  if (AlarmeCruzado = 1) and HasPosition and (sBarsPos >= 1) and (sAlvoPx > 0) then
  begin
    sBar := CurrentBar;
    if ((sLadoPos > 0) and ((sHigh >= sAlvoPx) or (sLow <= sStopPx)))
       or ((sLadoPos < 0) and ((sLow <= sAlvoPx) or (sHigh >= sStopPx))) then
      ConsoleLog("NTSI|ALVO_CRUZADO|" + sData + "|" + sHora + "|" + sBar
        + "|" + sLadoPos + "|" + sAlvoPx + "|" + sStopPx + "|" + sHigh
        + "|" + sLow + "|" + sBarsPos);
  end;

  if (LogAtivo = 1) and LastBarOnChart then
  begin
    if (sStatus <> 0) or (sEvento <> 0)
       or ((HeartbeatBarras > 0) and (Mod(CurrentBar, HeartbeatBarras) = 0)) then
      ConsoleLog("NTSI|" + sData + "|" + sHora + "|" + sClose + "|" + sRef
        + "|" + sLado + "|" + sNivelDet + "|" + sStatus + "|" + sEvento
        + "|" + sLadoPos + "|" + sAlvoPx + "|" + sStopPx
        + "|" + sBarsPos + "|" + sOps + "|" + sRefrat + "|" + sDailyRes);
  end;
end;
