//=====================================================================
// absorcao_dir — VISUALIZACAO EXPLORATORIA (nao e' sinal validado)
//
// Reproduz no grafico do Profit a feature `absorcao_dir` do profit-tape:
//
//     imbalance    = (agr_compra - agr_venda) / (agr_compra + agr_venda)
//     desloc_norm  = (Close - Open) / (High - Low)
//     absorcao_dir = imbalance - desloc_norm
//     z            = (x - media[1..Janela]) / desvio[1..Janela]
//
// AVISO QUE NAO E' DECORATIVO
// ---------------------------
// Este indicador NAO tem limiar validado. A hipotese que ele desenha foi
// REPROVADA no IC em 2026-08-30 (CONTRA nas 12 celulas; ver
// docs/RESEARCH_PLANO.md). O `Limiar` abaixo foi escolhido para ser
// VISIVEL, nao para ter edge. A barra vermelha significa "esta barra
// esta na cauda da distribuicao recente desta conta", e nada alem disso.
//
// O uso legitimo e' GERAR HIPOTESE: olhar as barras que a sua leitura
// visual identifica como absorcao e ver o que esta formula deixou de
// fora. Calibrar `Limiar` olhando o grafico ate "ficar bom" e' overfit
// visual — se algo aparecer, vira pre-registro novo, testado em amostra
// NOVA, e nunca uma regra ajustada na tela.
//
// EQUIVALENCIA COM O PYTHON: NAO E' EXATA, POR DUAS RAZOES CONHECIDAS
// -------------------------------------------------------------------
// 1. O OHLC do grafico inclui TODOS os negocios; o do profit-tape usa
//    SO agressao (RLP e leilao ficam de fora). Um RLP que imprima uma
//    nova maxima muda `desloc_norm` aqui e nao muda la.
// 2. AgressionVolBuy/Sell sao indicadores "TR" da Scalper Trader; nao
//    esta documentado se excluem RLP. Se nao excluirem, `imbalance`
//    diverge tambem.
//
// O log existe para MEDIR essas divergencias em vez de supo-las. Depois
// de um replay, rode:
//     profit-tape ntsl-equivalencia --log <dump> --features <parquet>
//
// LICENCA: AgressionVolBuy/Sell exigem Pro, Ultra ou modulo Scalper.
// Sem isso o indicador nao calcula (nao ha erro, os valores vem zerados
// — o que e' exatamente o tipo de falha silenciosa que o log revela).
//=====================================================================

input
  Limiar(1.75);             // |z| para colorir. NAO VALIDADO.
  LimiarImb(1.00);          // |z| de imbalance que separa A de B.
                            // NAO VALIDADO. Ver bloco "AS QUATRO CORES".
                            // 1,75 = 6,3% das barras (~7/pregao no 5m),
                            // escolhido pela FREQUENCIA de inspecao, nunca
                            // por resultado. Ver RESEARCH_PLANO 2026-08-30b.
  Janela(50);               // barras do z-score. 5m:50 / 1m:250 (=250 min)
  MostrarLadoOposto(1);     // 1 = pinta tambem o lado negativo
  LogAtivo(1);              // 1 = emite ConsoleLog
  LogSomenteSinal(0);       // 1 = loga so' barras coloridas
  LogDataInicio(0);         // 0 = sem filtro. Formato de Date():
                            // 1AnoMesDia, entao 01/07/2026 = 1260701.
  LogDataFim(0);            // 0 = sem filtro. Idem.

var
  sAgrCompra, sAgrVenda, sVolAgr, sImbalance : Float;
  sMediaImb, sDpImb, sZImb                   : Float;
  sVolTotal, sVolSoAgr                       : Float;
  sAmplitude, sDeslocNorm, sAbsorcaoDir      : Float;
  sSoma, sSomaQuad, sMedia, sDesvio, sZ, sD  : Float;
  nIndex                                     : Integer;
  bPintou, bNaJanela                         : Boolean;
begin
  sAgrCompra := AgressionVolBuy;
  sAgrVenda  := AgressionVolSell;
  sVolAgr    := sAgrCompra + sAgrVenda;

  // Duas versoes do volume total, logadas para DIAGNOSTICO:
  //   (False, False) = tudo, incluindo leilao e negocios diretos (RLP)
  //   (False, True)  = so' agressores
  // O manual avisa que `SoAgressores` SO e' considerado com o opcional
  // "Plugin Tape Reading"; sem ele o indicador e' sempre calculado como
  // False, INDEPENDENTE do que for passado — sem erro, sem aviso.
  // Logo: se as duas colunas forem IDENTICAS em todas as barras, ou o
  // WIN nao tem RLP nem leilao (implausivel) ou o opcional nao esta
  // assinado e o parametro esta sendo ignorado em silencio. E' o unico
  // jeito de detectar essa falha de fora.
  sVolTotal  := QuantityVol(False, False);
  sVolSoAgr  := QuantityVol(False, True);

  // Barra sem agressao: imbalance indefinido. Zero e' o unico valor que
  // nao inventa direcao (mesma guarda do flow.py).
  if sVolAgr > 0 then
    sImbalance := (sAgrCompra - sAgrVenda) / sVolAgr
  else
    sImbalance := 0;

  // Barra que nao andou nao tem "para onde o preco fechou".
  sAmplitude := High - Low;
  if sAmplitude > 0 then
    sDeslocNorm := (Close - Open) / sAmplitude
  else
    sDeslocNorm := 0;

  sAbsorcaoDir := sImbalance - sDeslocNorm;

  //-------------------------------------------------------------------
  // z-score ANTI-LOOKAHEAD.
  // A media e o desvio vem de [1]..[Janela] — a propria barra NAO entra.
  // Isso replica o `.shift(1)` de features/normalize.py, que e' o unico
  // ponto do projeto com janela rolante justamente porque e' onde
  // lookahead se esconde.
  // Desvio com divisor (Janela-1): ddof=1, igual ao default do pandas.
  // Divisor errado aqui produz um z sistematicamente diferente do
  // Python, e a comparacao de equivalencia acusaria sem dizer por que.
  //-------------------------------------------------------------------
  sZ := 0;
  if CurrentBar > Janela then
  begin
    sSoma := 0;
    for nIndex := 1 to Janela do
      sSoma := sSoma + sAbsorcaoDir[nIndex];
    sMedia := sSoma / Janela;

    sSomaQuad := 0;
    for nIndex := 1 to Janela do
    begin
      sD := sAbsorcaoDir[nIndex] - sMedia;
      sSomaQuad := sSomaQuad + sD * sD;
    end;
    sDesvio := Sqrt(sSomaQuad / (Janela - 1));

    if sDesvio > 0 then
      sZ := (sAbsorcaoDir - sMedia) / sDesvio;
  end;

  Plot(sZ);

  // z positivo NAO significa por si so' "compradores agrediram e nao
  // levaram": pode ser isso (caso A) ou "o preco caiu sem vendedor
  // agredir" (caso B). O sZImb abaixo e' o que separa os dois.
  //-------------------------------------------------------------------
  // z do IMBALANCE, mesma janela e mesmo anti-lookahead do principal.
  //
  // Precisa ser o z, e nao o valor cru: `imbalance` raramente sai de
  // +-0,3 enquanto `desloc_norm` vai ate +-1, entao comparar as
  // magnitudes CRUAS classificaria quase tudo como B.
  //
  // Fica DENTRO do mesmo `if CurrentBar > Janela`: antes do aquecimento
  // sZ e' 0 e nenhuma barra pinta, entao classificar ali seria calcular
  // um numero que nao vai ser usado — e que, se algum dia fosse, viria
  // de uma amostra curta demais.
  //-------------------------------------------------------------------
  sZImb := 0;
  if CurrentBar > Janela then
  begin
    sSoma := 0;
    for nIndex := 1 to Janela do
      sSoma := sSoma + sImbalance[nIndex];
    sMediaImb := sSoma / Janela;

    sSomaQuad := 0;
    for nIndex := 1 to Janela do
    begin
      sD := sImbalance[nIndex] - sMediaImb;
      sSomaQuad := sSomaQuad + sD * sD;
    end;
    sDpImb := Sqrt(sSomaQuad / (Janela - 1));

    if sDpImb > 0 then
      sZImb := (sImbalance - sMediaImb) / sDpImb;
  end;

  //---------------------------------------------------------------------
  // AS QUATRO CORES
  //
  // `absorcao_dir = imbalance - desloc_norm` e' uma SUBTRACAO, e um valor
  // extremo pode vir de dois lugares OPOSTOS. Descoberto com uma barra
  // real (2026-08-31, 09:03-09:05): imbalance +0,049 (agressao quase
  // empatada) e desloc_norm +0,951 (quase marubozu de alta) davam
  // absorcao_dir -0,902 -> aqua. Mas nao houve vendedor agredindo coisa
  // nenhuma: o preco subiu 326 ticks porque o livro estava FINO.
  //
  //   CASO A  (absorcao de verdade): a agressao empurrou para um lado e
  //           o preco foi para o outro. Ha' esforco, e ele FALHOU.
  //           -> exige |z_imbalance| >= LimiarImb no sentido contrario
  //              ao deslocamento.
  //
  //   CASO B  (livro fino): o preco andou muito SEM agressao dominante.
  //           Nao e' resistencia escondida; e' AUSENCIA de resistencia.
  //           -> z_imbalance perto de zero.
  //
  // Os dois pintavam a MESMA cor. Agora nao pintam mais.
  //
  //   clRed     A - comprador agrediu e NAO levou   (vendedor passivo)
  //   clAqua    A - vendedor agrediu e NAO levou    (comprador passivo)
  //   clFucsia  B - preco CAIU sem esforco vendedor (livro fino)
  //   clYellow  B - preco SUBIU sem esforco comprador (livro fino)
  //
  // LimiarImb NAO E' VALIDADO, igual ao Limiar. Serve para separar duas
  // leituras, nao para gerar sinal.
  //---------------------------------------------------------------------
  bPintou := False;
  if sZ >= Limiar then
  begin
    // familia vermelha: absorcao_dir alto
    if sZImb >= LimiarImb then
      PaintBar(clRed)        // A: comprador agrediu e nao levou
    else
      PaintBar(clFucsia);    // B: preco caiu sem esforco vendedor
    bPintou := True;
  end
  else if (MostrarLadoOposto = 1) and (sZ <= -Limiar) then
  begin
    // familia aqua: absorcao_dir baixo
    if sZImb <= -LimiarImb then
      PaintBar(clAqua)       // A: vendedor agrediu e nao levou
    else
      PaintBar(clYellow);    // B: preco subiu sem esforco comprador
    bPintou := True;
  end;

  //-------------------------------------------------------------------
  // LOG. So' de barras que o motor nao reavalia mais.
  //
  // O manual e' explicito: "o mesmo candle pode ser processado diversas
  // vezes... cada trade pode gerar uma notificacao de reprocessamento",
  // e a cada tick sao reavaliados "o ultimo e o penultimo candle". Com
  // ~42.000 negocios por barra de 5m no WINFUT, logar a barra em
  // formacao produziria dezenas de milhares de linhas por barra.
  //
  // CurrentBar <= BarCount - 3 pega a barra a partir da terceira de tras
  // para frente: fora da janela de reavaliacao por tick. Em replay, cada
  // barra e' logada uma vez, com dois candles de atraso. Na carga do
  // historico, o grafico inteiro sai de uma vez.
  //
  // Se o motor reprocessar candles passados (o manual avisa que pode
  // acontecer), haverao linhas duplicadas — por isso o comparador
  // deduplica por data+hora e REPORTA quantas duplicatas viu, em vez de
  // esconde-las.
  //
  // JANELA DE DATA (LogDataInicio / LogDataFim)
  //
  // O console do Profit tem buffer finito (~2.000 linhas medidas em
  // 2026-08-30). Como a carga de historico processa as barras em ordem
  // CRONOLOGICA, o buffer enche a partir da barra MAIS ANTIGA e para:
  // carregando desde 03/2025, as vagas acabaram em 30/06/2026 e agosto
  // nunca apareceu. Quanto MAIS historico o grafico tem, mais CEDO o log
  // termina — o oposto do que a intuicao sugere.
  //
  // O filtro de data resolve porque o indicador continua CALCULANDO
  // sobre todo o historico — a janela de 50 barras e o aquecimento do
  // z-score ficam intactos, sem artefato de borda — e apenas o
  // ConsoleLog e' suprimido fora da janela. Filtrar reduzindo o periodo
  // do grafico teria custado o aquecimento; filtrar aqui nao custa nada.
  //
  // Nao da para fazer isso pelos parametros do Profit: "tick a tick =
  // 1 semana" e' limite de backtest/automacao, e o indicador nao o
  // respeita.
  //
  // Campos separados por | para o parser. Ordem CONGELADA: mudar aqui
  // exige mudar tools/ntsl_equivalencia.py junto.
  //-------------------------------------------------------------------
  bNaJanela := ((LogDataInicio = 0) or (Date >= LogDataInicio))
           and ((LogDataFim    = 0) or (Date <= LogDataFim));

  if (LogAtivo = 1) and bNaJanela and (CurrentBar <= BarCount - 3) then
  begin
    if (LogSomenteSinal = 0) or bPintou then
      // Date() vem no formato EasyLanguage 1AnoMesDia (24/08/2026 =>
      // 1260824, ano deslocado de 1900). Time e TimeExchange sao os DOIS
      // logados de proposito: se o grafico estiver num fuso diferente do
      // da bolsa, a juncao pelo campo errado falharia em TODAS as barras
      // — barulho alto e diagnosticavel, mas melhor evitar de uma vez.
      ConsoleLog("ABSDIR|" + Date + "|" + Time + "|" + TimeExchange
        + "|" + Open + "|" + High + "|" + Low + "|" + Close
        + "|" + sVolTotal + "|" + sVolSoAgr
        + "|" + sAgrCompra + "|" + sAgrVenda
        + "|" + sImbalance + "|" + sDeslocNorm + "|" + sAbsorcaoDir
        + "|" + sMedia + "|" + sDesvio + "|" + sZ
        + "|" + sZImb);
  end;
end;
