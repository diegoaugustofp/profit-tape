# Copie para .env  (o .env esta no .gitignore — credencial nao entra no repositorio)
PROFIT_ACTIVATION_KEY=
PROFIT_USER=
PROFIT_PASSWORD=
PROFIT_DLL_PATH=C:\Profit\ProfitDLL64.dll

# Opcional: carga no TimescaleDB
PROFIT_PG_DSN=postgresql://quant:quant@localhost:5432/marketdata

# --- EA (docs/EA_ARQUITETURA.md) — NAO operacional ainda, preencha so' ---
# --- quando for testar o modulo ea/. Mesma DLL, mesmo login acima; os ---
# --- campos abaixo sao so' para ROTEAMENTO DE ORDEM (real x simulacao). ---
# Rode GetAccount() uma vez (fora do horario de pregao) para descobrir os
# dois pwcIDAccount (demo e real) e o pwcIDCorretora.
ROTEAMENTO_SENHA_ROTEAMENTO=
# CORRETORA E' DIFERENTE POR CONTA (medido em 2026-08-31 via `ea-contas`):
#   corretora_id=32006  Simulador                   -> conta DEMO
#   corretora_id=1003   XP Investimentos CCTVM S/A  -> conta REAL
# A demo fica numa corretora simulada da Nelogica; a real, na de verdade.
# Mandar ordem com a corretora errada NAO da' erro de configuracao.
ROTEAMENTO_ID_CORRETORA_DEMO=
ROTEAMENTO_ID_ACCOUNT_DEMO=
ROTEAMENTO_ID_CORRETORA_REAL=
ROTEAMENTO_ID_ACCOUNT_REAL=

# Campo antigo, mantido so' para nao quebrar .env existente: vale como
# fallback da corretora DEMO. Em config nova, use os dois acima.
ROTEAMENTO_ID_CORRETORA=
